module arimo.test.phase1a;

// ── Phase 1a: Fixed-size integers, bitwise ops, as cast ───────────────────────
// ── Phase 1b: type alias ──────────────────────────────────────────────────────

// Module-level type alias
type NodeId   = u32;
type ByteFlag = u8;

@ManualMemory
public class BitwiseDemo {

    private flags : u32;
    private data  : RawPtr<u8>;

    public static readonly MAX_SIZE : u32 = 1024;
    public static readonly PAGE_BITS : u8 = 12;

    public constructor(initial: u32) {
        this.flags = initial;
        this.data  = Memory.alloc(256 * u8.sizeOf());
    }

    public setFlag(mask: u32) : Void {
        this.flags = this.flags | mask;
    }

    public clearFlag(mask: u32) : Void {
        this.flags = this.flags & ~mask;
    }

    public toggleFlag(mask: u32) : Void {
        this.flags = this.flags ^ mask;
    }

    public shiftLeft(n: u32) : u32 {
        return this.flags << n;
    }

    public shiftRight(n: u32) : u32 {
        return this.flags >> n;
    }

    public toU8() : u8 {
        return this.flags as u8;
    }

    public toI32() : i32 {
        return this.flags as i32;
    }

    public dispose() : Void {
        Memory.free(this.data);
    }
}

public class IntegerTypes {

    public static readonly VERSION : u32 = 2;

    public static demo() : Void {
        u8  byte     = 255;
        u16 short_   = 65535;
        u32 word     = 0xDEADBEEF;
        u64 qword    = 0xFFFFFFFFFFFFFFFF;
        i8  sbyte    = -128;
        i16 sshort   = -32768;
        i32 sint     = -2147483648;
        i64 slong    = -1;

        u32 flags    = 0xFF00FF00;
        u8  mask     = 0b10101010;

        u32 result   = flags & 0xFF;
        u32 orTest   = flags | 0x00FF;
        u32 xorTest  = flags ^ 0xAAAA;
        u32 shifted  = flags << 4;
        u32 rshifted = flags >> 2;
        u8  inverted = ~mask;

        u8  low      = flags as u8;
        i32 signed   = flags as i32;
        u32 fromInt  = 42 as u32;

        IO.print("Integer types OK");
    }
}
