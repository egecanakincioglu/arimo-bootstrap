module arimo.test.phase1c;

// ── Phase 1c: struct, operator overloading, @inline ───────────────────────────

// Matematiksel vektör — game engine kullanımı
public struct Vec3 {
    x : Float;
    y : Float;
    z : Float;

    @ForceInline
    public operator +(other: Vec3) : Vec3 {
        return Vec3(this.x + other.x, this.y + other.y, this.z + other.z);
    }

    @ForceInline
    public operator -(other: Vec3) : Vec3 {
        return Vec3(this.x - other.x, this.y - other.y, this.z - other.z);
    }

    @ForceInline
    public operator *(scalar: Float) : Vec3 {
        return Vec3(this.x * scalar, this.y * scalar, this.z * scalar);
    }

    public operator ==(other: Vec3) : Boolean {
        return this.x == other.x && this.y == other.y && this.z == other.z;
    }

    @ForceInline
    public dot(other: Vec3) : Float {
        return this.x * other.x + this.y * other.y + this.z * other.z;
    }

    public length() : Float {
        return Math.sqrt(this.dot(this));
    }
}

// Renk — value type semantiği
public struct Color {
    r : u8;
    g : u8;
    b : u8;
    a : u8;

    public static readonly WHITE : Color = Color(255, 255, 255, 255);
    public static readonly BLACK : Color = Color(0, 0, 0, 255);

    public withAlpha(alpha: u8) : Color {
        return Color(this.r, this.g, this.b, alpha);
    }

    public toU32() : u32 {
        u32 rv = this.r as u32;
        u32 gv = this.g as u32;
        u32 bv = this.b as u32;
        u32 av = this.a as u32;
        return (rv << 24) | (gv << 16) | (bv << 8) | av;
    }
}

// type alias ile birlikte
type Vec2 = Vec3;

public class PhysicsWorld {

    public static simulate() : Void {
        Vec3 pos = Vec3(0.0, 0.0, 0.0);
        Vec3 vel = Vec3(1.0, 2.0, 0.0);

        // Operator overloading — pos + vel
        Vec3 newPos = pos + vel;

        // copy semantics — pos hâlâ geçerli
        Vec3 savedPos = pos;

        // scalar multiply
        Vec3 scaled = vel * 2.0;

        // dot product
        Float d = pos.dot(vel);

        // equality
        Boolean same = pos == savedPos;

        // Color operations
        Color red    = Color(255, 0, 0, 255);
        Color faded  = red.withAlpha(128);
        u32   packed = red.toU32();

        IO.print("Physics OK");
    }
}
